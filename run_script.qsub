#!/bin/bash
#PBS -N Chopper_Minibar
#PBS -P vz35
#PBS -l wd
#PBS -m e
#PBS -M ziyan.zhang@anu.edu.au
#PBS -l ncpus=16
#PBS -l mem=64GB
#PBS -l jobfs=200GB
#PBS -l walltime=08:00:00
#PBS -l storage=gdata/vz35
#PBS -q biodev

#--------README---------------------------------------------------------------
# Slim wrapper around the Python core pipeline.
#   Pre-step: generate_primer_setup.py  -> ITS_primer_setup_<date>.txt        (cutadapt)
#                                          ITS_primer_setup_minibar_<date>.txt (Minibar)
#   Core:     filter_chopper_demux_minibar.py
#               Step 1 - Chopper filter, whole files  (pre mode only)
#               Step 2 - Minibar demultiplex + merge (-e/-E from Variables
#                        below; -l 200 -M 2 -F set in the Python. -M 2 is
#                        required by the combinatorial index layout)
#               Step 3 - Per-sample demux QC -> demux_qc/
#               Step 4 - Chopper filter, per sample   (post mode only)
#               Step 5 - Cutadapt two-pass: orient reads + trim 5'/3'
#                        constructs (cutadapt_2pass.py)
#               Step 6 - Organise reads by client + write summaries
#               Step 7 - Collect logs into run_log_<date>/
#   Post-step: qc_report.py -> qc_report/  (per-sample PASS / CHECK / FAIL)
#
# Both modes share this numbering, so step N means the same thing in either
# job log. pre skips step 4; post skips step 1.
#
# Set filter_stage below to choose when Chopper runs. post is the production
# default: MinKNOW already drops reads < 400 bp and < Q15 from fastq_pass on
# ITS runs, the same floor as Chopper's min_length, so post mode only adds
# the > max_length reads to Minibar's load, and it is the only mode in which
# the QC report can see them (long_frac). pre is kept as the legacy ordering.
#
# For a first look at an unfamiliar run, add --diagnostic to the core call:
# it forces post mode with a 100-5000 bp window so the demux QC observes the
# real length distribution instead of assuming 400-1200.
#
#--------Resource notes-------------------------------------------------------
# Taken from the 16S workflow (v6.00), which uses the same parallel Minibar
# step. Not yet confirmed on an ITS run -- check the PBS resource footer and
# the Step 2 timestamps of the first post-mode ITS job and adjust.
#
# ncpus=16     Step 2 runs Minibar on several chunks at once, one
#              subprocess per worker, with max_workers taken from
#              $PBS_NCPUS. Minibar itself is still single-threaded pure
#              Python, so the chunk count is the unit of parallelism.
#              The speed-up is bounded by the number of large chunks and
#              then by the single largest chunk. Stay within one node
#              (48 cores or fewer on Gadi); this is a shared-memory thread
#              pool, not an MPI job.
#
# mem=64GB     About 4GB per core, the usual Gadi ratio. Each worker holds
#              one Minibar process, so peak memory scales with ncpus. Trim
#              this if the first run's peak is nowhere near 64GB.
#
# walltime=8h  Was 20h for the old serial loop. Step 2 is the dominant cost
#              and is now parallel. Post mode feeds Minibar every read in
#              fastq_pass, not only the 400-1200 bp ones, so confirm the
#              margin against the Step 2 timestamps of the first post run.
#
# jobfs=200GB  Was 10GB. Minibar's per-chunk working directories go to
#              $PBS_JOBFS (node-local) in both modes; in post mode they hold
#              unfiltered, uncompressed reads and are much larger than in
#              pre mode. Pre mode also writes its Chopper output there now.
#              On queues that ration jobfs per core, 200GB may need a
#              certain ncpus to be schedulable: raise ncpus before lowering
#              jobfs.
#
# storage      gdata/vz35 covers every path this job touches, and nothing
#              here touches /scratch or /tmp: the PromethION uploads (input),
#              sample_sheet/, tools/ (both ONT_ITS_workflow and the shared
#              ONT_16s_workflow tools) and minibar_output/ (output) all live
#              under /g/data/vz35. $PBS_JOBFS is node-local and needs no
#              storage flag.
#-----------------------------------------------------------------------------

set -euo pipefail

#--------Module---------------------------------------------------------------
module load python3/3.12.1

date_stamp=$(date +%Y%m%d)

#--------Variables (edit per run)---------------------------------------------
# run name under /g/data/vz35/PromethION_data/sequencer_uploads/
run_name=ONT_ITS_20260617

# sample sheet CSV (columns: Client, Sample_ID, Barcode; Barcode = ITS01-ITS96;
# optional Comment, Location, Sample_Type = SAMPLE / NTC / BLANK / POS_CTRL)
samplesheet=/g/data/vz35/ONT_ITS_workflow/sample_sheet/ITS_samplesheet_20260721.csv

# Barcode references. The same barcode set is needed in two forms, one per tool:
#   *_minibar : FwPrimer/RvPrimer stop after the Illumina tail + 10 bp index,
#               so Minibar matches only the constant barcoded tail.
#   cutadapt  : full construct, carrying the degenerate ITS gene primer as well,
#               because cutadapt has to trim the gene primer off too.
# Both must cover every barcode ID used in the sample sheet's Barcode column.
# If you swap in a different barcode set, also re-check min_length/max_length
# and primer_mismatch below — both are tuned for the IDT ITS construct.
barcode_file_minibar=/g/data/vz35/ONT_ITS_workflow/tools/IDT_ITS_96_barcode_minibar.txt
barcode_file_cutadapt=/g/data/vz35/ONT_ITS_workflow/tools/IDT_ITS_96_barcode.txt

# run output (will hold integrated_demultiplexing/ + demux_qc/ + qc_report/)
output_dir=/g/data/vz35/ONT_ITS_workflow/minibar_output/ONT_ITS_TBC_${date_stamp}

# when Chopper runs relative to demultiplexing:
#   post - demultiplex raw fastq_pass, then filter per sample   (default)
#   pre  - filter raw fastq.gz first, then demultiplex          (legacy)
filter_stage=post

# 1 = write the per-sample QC report (qc_report/) after the pipeline.
# Non-fatal: a QC failure is reported but does not fail the job.
run_qc_report=1


#--------Variables index, change as needed-------------------------------------
# Chopper read filtering. The length window must bracket the expected amplicon
# for the primer pair in use, so re-check it whenever the primers change.
#   ITS (ITS1F/ITS4): main peak ~0.78-0.80 kb, shoulder ~0.60-0.70 kb,
#                     concatemers/junk above ~1.5 kb  -> 400-1200
#   full-length 16S:  ~1.5 kb                         -> 1000-2000
# qc_config.yaml mirrors these (filter.minknow_min_len / chopper_max_len); if
# you change them here, change them there too, or the QC report warns that
# the windows differ.
min_quality=15
min_length=400
max_length=1200

# Minibar primer matching. -E is the allowed edit distance when matching the
# primer. 9 is a holdover from when Minibar matched the full construct, whose
# IUPAC-degenerate ITS primer positions counted as mismatches before any real
# sequencing error.
# Test done 20260722, primer_mismatch= 5/9 gave the same result.
# Re-check whenever the primers or the *_minibar reference change.
primer_mismatch=9

# Minibar barcode matching. -e is the allowed edit distance when matching the
# barcode index. Raising it above 1 can rescue some unassigned (unk) reads but
# also grows Multiple_Matches, because the IDT ITS FwIndex set has a minimum
# pairwise Hamming distance of only 3.
# Test done 20260722, keep barcode_mismatch=1.
barcode_mismatch=1

#--------DONT-CHANGE----------------------------------------------------------
# only one run folder per directory allowed
_root=/g/data/vz35/PromethION_data/sequencer_uploads
mapfile -t _fq_dirs < <(find "${_root}/${run_name}" -type d -name "fastq_pass")
if [[ ${#_fq_dirs[@]} -eq 0 ]]; then
    echo "ERROR: fastq_pass not found under ${_root}/${run_name}" >&2
    exit 1
elif [[ ${#_fq_dirs[@]} -gt 1 ]]; then
    echo "ERROR: multiple fastq_pass directories found under ${_root}/${run_name}:" >&2
    printf '  %s\n' "${_fq_dirs[@]}" >&2
    exit 1
fi
raw_input_dir="${_fq_dirs[0]}"

tools_dir=/g/data/vz35/ONT_ITS_workflow/tools/brf_ont_ITS_workflow/
generate_primer_script=${tools_dir}/generate_primer_setup.py # attention to location
core_script=${tools_dir}/filter_chopper_demux_minibar.py # attention to location
qc_script=${tools_dir}/qc_report.py
qc_config=${tools_dir}/qc_config.yaml
# QC venv (PyYAML, matplotlib) is shared with the 16S workflow, like the tools.
qc_python=/g/data/vz35/ONT_16s_workflow/tools/qc_env/bin/python3

primer_output_dir=/g/data/vz35/ONT_ITS_workflow/sample_sheet
# Generated primer setup files (derived from primer_output_dir + date_stamp).
primer_file="${primer_output_dir}/ITS_primer_setup_${date_stamp}.txt"                 # cutadapt
primer_file_minibar="${primer_output_dir}/ITS_primer_setup_minibar_${date_stamp}.txt" # Minibar

case "$filter_stage" in
    pre|post) ;;
    *) echo "ERROR: filter_stage must be 'pre' or 'post', got '${filter_stage}'" >&2
       exit 1 ;;
esac

mkdir -p "$output_dir"

# Both modes: keep Minibar's bulky per-chunk working directories on
# node-local jobfs. They are purely intermediate -- only the merged
# per-sample fastqs land in $output_dir -- and the per-chunk minibar.log
# files are copied back there by the core script before cleanup.
core_extra_args=()
if [[ -n "${PBS_JOBFS:-}" ]]; then
    minibar_work_dir="${PBS_JOBFS}/minibar_work"
else
    # interactive / non-PBS fallback (never /tmp)
    minibar_work_dir="${output_dir}/minibar_work"
    echo "WARNING: PBS_JOBFS unset; Minibar working dirs go to ${minibar_work_dir}" >&2
fi
mkdir -p "$minibar_work_dir"
core_extra_args+=(--minibar-work-dir "$minibar_work_dir")

#=============================================================================
# PRE-STEP: Generate primer setup file
#=============================================================================
echo "========================================"
echo " PRE-STEP: Generating primer setup: $(date)"
echo "========================================"
echo " Samplesheet: $samplesheet"

# The generator always writes ITS_primer_setup_<date>.txt, so build the Minibar
# file first (from the *_minibar barcode reference) and rename it out of the
# way, then build the cutadapt file, which keeps the default name. Same
# generator, invoked twice against different -b inputs.
python3 "$generate_primer_script" \
    "$samplesheet" \
    -b "$barcode_file_minibar" \
    -o "$primer_output_dir" \
    --date "$date_stamp"
mv "$primer_file" "$primer_file_minibar"

python3 "$generate_primer_script" \
    "$samplesheet" \
    -b "$barcode_file_cutadapt" \
    -o "$primer_output_dir" \
    --date "$date_stamp"

echo " Primer file (cutadapt): $primer_file"
echo " Primer file (Minibar):  $primer_file_minibar"
echo "========================================"

#=============================================================================
# CORE: Chopper filter -> Minibar demux -> demux QC -> cutadapt -> by client
#       (Chopper runs before or after demux depending on $filter_stage)
#=============================================================================
echo " Filter stage: ${filter_stage}"
echo " Minibar work dir: ${minibar_work_dir}"
echo "========================================"

python3 "$core_script" \
    --raw-input-dir "$raw_input_dir" \
    --output-dir    "$output_dir" \
    --primer-file          "$primer_file" \
    --minibar-primer-file  "$primer_file_minibar" \
    --samplesheet   "$samplesheet" \
    --filter-stage  "$filter_stage" \
    --min-quality     "$min_quality" \
    --min-length      "$min_length" \
    --max-length      "$max_length" \
    --primer-mismatch  "$primer_mismatch" \
    --barcode-mismatch "$barcode_mismatch" \
    ${core_extra_args[@]+"${core_extra_args[@]}"}
    # ^ expands to nothing when the array is empty, without tripping `set -u`
    #   on older bash where "${arr[@]}" counts as an unbound reference.

#=============================================================================
# POST-STEP: per-sample QC report (reads demux_qc/ + read_counts_summary.txt)
#=============================================================================
# Takes seconds. Deliverables are already in place by now, so a QC failure
# is reported but does not fail the job; re-run it by hand or with
# run_qc_report.qsub. Uses the qc_env venv (PyYAML, matplotlib) via its own
# python, so the core pipeline's environment is untouched.
if [[ "$run_qc_report" == "1" ]]; then
    if [[ ! -x "$qc_python" ]]; then
        echo "WARNING: QC venv python not found at ${qc_python}; skipping QC report." >&2
        echo "         Re-run with: qsub -v output_dir=${output_dir},samplesheet=${samplesheet} run_qc_report.qsub" >&2
    elif "$qc_python" "$qc_script" \
        --output-dir  "$output_dir" \
        --samplesheet "$samplesheet" \
        --config      "$qc_config"; then
        echo " QC report: ${output_dir}/qc_report/qc_report.html"
    else
        echo "WARNING: qc_report.py failed; pipeline outputs are unaffected." >&2
        echo "         Re-run with: qsub -v output_dir=${output_dir},samplesheet=${samplesheet} run_qc_report.qsub" >&2
    fi
fi
